# ========================================================
# Portfolio Command Center - Environment Configuration Template
# Copy this file to .env and fill in your values
# ========================================================

# 1. Google Sheets Configuration
# The ID extracted from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# 2. Google Service Account Credentials
# Path to your downloaded service account JSON file:
GOOGLE_CREDENTIALS_FILE=credentials.json

# (Optional) For Cloud Deployments (Render, Railway, Heroku, etc.):
# You can paste the raw JSON string directly instead of mounting a file:
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# 3. Server Configuration
PORT=5000
HOST=0.0.0.0

# 4. Optional Security & Webhooks
# ADMIN_PASSWORD=your-secure-admin-password
# WEBHOOK_SECRET=your-webhook-signing-secret
